<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.quickride">
    <!-- Permissions -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />


    <application
        android:name=".ApplicationClass"
        android:allowBackup="true"
        android:icon="@drawable/ic_driver"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_logo"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <meta-data
            android:name="com.onesignal.NotificationServiceExtension"
            android:value="com.example.quickride.utils.MyNotificationServiceExtension" />

        <activity
            android:name=".auth.RoleSelectionActivity"
            android:exported="false" />
        <!-- Launcher Activity -->
        <activity
            android:name=".auth.LauncherActivity"
            android:exported="true"
            android:theme="@style/AppTheme.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".auth.AuthenticationActivity" />
        <activity android:name=".auth.DetailsActivity" />
        <activity
            android:name=".customer.CustomerMapActivity"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".customer.CustomerSettingsActivity"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".driver.DriverMapActivity"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".driver.DriverSettingsActivity"
            android:theme="@style/AppTheme.NoActionBar" />


        <activity
            android:name=".driver.DriverChooseTypeActivity"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".driver.CreateFixedRouteActivity"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".customer.FixedRoutesSearchActivity"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".driver.ViewFixedRouteBookingsActivity"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".history.HistoryActivity"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity android:name=".history.HistorySingleActivity" />
        <activity android:name=".payment.PaymentActivity" />
        <activity android:name=".payment.AddPaymentActivity" />
        <activity
            android:name=".payment.PayoutActivity"
            android:theme="@style/AppTheme.NoActionBar" />
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/google_maps_key" />

        <service
            android:name=".services.DriverForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>


</manifest>